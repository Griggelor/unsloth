+@pytest.mark.parametrize("peft_enabled", [False, True])
+def test_re_enabling_a_transformers_model_keeps_one_embedding_hook(peft_enabled):
+    transformers = pytest.importorskip("transformers")
+    config = transformers.LlamaConfig(
+        vocab_size = 32, hidden_size = 16, intermediate_size = 32, num_hidden_layers = 2,
+        num_attention_heads = 2, num_key_value_heads = 2, max_position_embeddings = 16,
+    )
+    # Hugging Face registers input-gradient hooks for PEFT, not every plain
+    # model. The expected count is read from the SAME installed HF version.
+    baseline = transformers.LlamaForCausalLM(config).train()
+    baseline._hf_peft_config_loaded = peft_enabled
+    baseline.gradient_checkpointing_enable()
+    expected = len(baseline.get_input_embeddings()._forward_hooks)
+    model = transformers.LlamaForCausalLM(config).train()
+    model._hf_peft_config_loaded = peft_enabled
+    for every_n in (1, 2, 1):
+        bc.enable_block_gradient_checkpointing(model, every_n)
+        assert model.is_gradient_checkpointing
+        assert len(model.get_input_embeddings()._forward_hooks) == expected
 
 
